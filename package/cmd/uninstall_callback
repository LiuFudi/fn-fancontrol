#!/bin/bash
# Called after the application files have been removed.
#
# User data (TRIM_PKGETC/TRIM_PKGVAR) is deliberately preserved so a reinstall
# keeps the curves. Only runtime leftovers are cleaned up here.
set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
APPDEST="${TRIM_APPDEST:-$(cd "$SCRIPT_DIR/.." && pwd)}"
PKGETC="${TRIM_PKGETC:-${APPDEST}/etc}"
PKGVAR="${TRIM_PKGVAR:-${APPDEST}/var}"
PYTHON="$(command -v python3 || echo /usr/bin/python3)"
DAEMON="${APPDEST}/server/fancontrold.py"

# Last line of defence: never leave a fan stuck on a manual duty.
if [ -x "$PYTHON" ] && [ -r "$DAEMON" ]; then
    "$PYTHON" "$DAEMON" restore --appdest "$APPDEST" --etc "$PKGETC" >> "${PKGVAR}/uninstall.log" 2>&1 || true
fi

rm -f "${APPDEST}/app.sock" "${PKGVAR}/app.pid" 2>/dev/null
exit 0

# Python bytecode
__pycache__/
*.py[cod]

# fnpack leaves the unversioned artifact behind inside the source tree before
# build-fpk.sh renames it; only dist/ is meant to be committed.
package/*.fpk

# Release archives produced by the packaging helper
/*.tar.gz
/*.zip
/dist/*.tar.gz
/dist/*.zip

# Editor / OS noise
.DS_Store
Thumbs.db
*.swp
*~

# Local scratch
/build/
/scratch/
